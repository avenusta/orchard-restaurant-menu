@model DrinkPartViewModel

<div class="mb-3">
    <label asp-for="VolumeMl" class="form-label">@T["Volume (ml)"]</label>
    <input asp-for="VolumeMl" class="form-control" type="number" min="1" step="1" />
    <span asp-validation-for="VolumeMl" class="text-danger"></span>
</div>

<div class="mb-3 form-check">
    <input asp-for="IsAlcoholic" class="form-check-input" type="checkbox" />
    <label asp-for="IsAlcoholic" class="form-check-label">@T["Contains alcohol"]</label>
</div>
