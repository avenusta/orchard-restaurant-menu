@model MenuItemPartViewModel

<p class="menu-item__price@(Model.IsAvailable ? string.Empty : " menu-item__price--sold-out")">
    <span>@await DisplayAsync(await New.Price(Amount: Model.Price))</span>
    @if (!Model.IsAvailable)
    {
        <span class="menu-item__badge">@T["Sold out"]</span>
    }
</p>
