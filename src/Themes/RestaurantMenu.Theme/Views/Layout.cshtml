@using RestaurantMenu.Module.Services
@inject IRestaurantContext RestaurantContext

@{
    var restaurant = await RestaurantContext.GetCurrentAsync();
}

<!DOCTYPE html>
<html lang="@Orchard.CultureName()" dir="@Orchard.CultureDir()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@RenderTitleSegments(Site.SiteName, "before")</title>
    <style asp-src="~/RestaurantMenu.Theme/styles/site.css"></style>
    <resources type="Meta" />
    <resources type="HeadLink" />
    <resources type="Stylesheet" />
    <resources type="HeadScript" />
</head>
<body>
    <header class="site-header">
        <a class="site-header__name" href="~/">@Site.SiteName</a>
        <nav class="site-nav">
            <a href="~/menu">@T["Menu"]</a>
            <a href="~/search">@T["Search"]</a>
        </nav>
        @await RenderSectionAsync("Header", required: false)
    </header>

    <main class="site-main">
        @await RenderSectionAsync("Messages", required: false)
        @await RenderBodyAsync()
    </main>

    <footer class="site-footer">
        <div class="site-footer__restaurant">
            <strong>@restaurant.Name</strong>
            @if (!string.IsNullOrWhiteSpace(restaurant.Address))
            {
                <div>@restaurant.Address</div>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(restaurant.OpeningHours))
        {
            <div class="site-footer__hours">
                <strong>@T["Opening hours"]</strong>
                <div class="site-footer__hours-text">@restaurant.OpeningHours</div>
            </div>
        }
        @await RenderSectionAsync("Footer", required: false)
    </footer>

    <resources type="FootScript" />
</body>
</html>
