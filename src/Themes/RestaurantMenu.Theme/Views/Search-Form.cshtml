@model OrchardCore.Search.ViewModels.SearchFormViewModel

<form class="search__form" asp-action="Search" asp-controller="Search" asp-area="OrchardCore.Search" asp-route-index="@Model.Index" method="get" role="search">
    <input class="search__input" name="Terms" type="search" value="@Model.Terms" placeholder="@T["Dish or drink, e.g. goulash"]" aria-label="@T["Search the menu"]" autofocus />
    <button class="search__button" type="submit">@T["Search"]</button>
</form>
